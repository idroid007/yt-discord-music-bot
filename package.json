{
  "name": "yt-discord-music-bot",
  "version": "2.0.0",
  "description": "A personal Discord music bot that downloads YouTube audio with yt-dlp, caches it for a day, and streams it into voice channels.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "youtube",
    "yt-dlp"
  ],
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.1.1"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  }
}
